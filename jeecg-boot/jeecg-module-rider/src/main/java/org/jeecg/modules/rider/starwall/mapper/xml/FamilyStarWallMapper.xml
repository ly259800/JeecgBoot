<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.rider.starwall.mapper.FamilyStarWallMapper">


    <update id="addLikeCnt">
        update family_star_wall set like_cnt = ifnull(like_cnt,0) + #{cnt}
        WHERE id = #{id}
    </update>

</mapper>